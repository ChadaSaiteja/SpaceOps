<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>StorageIntelligence</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <!-- Unpackaged distribution per ADR-002/ADR-001 -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- MSIX-only tile/logo assets removed (unpackaged distribution, ADR-002/ADR-001). AppIcon.ico retained: used as the window icon (MainWindow.xaml.cs). -->
  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
  </ItemGroup>

  <!-- Publish Properties. Trimming is disabled: it breaks WinUI 3 / XAML reflection. ReadyToRun is kept for startup. -->
  <PropertyGroup>
    <PublishTrimmed>False</PublishTrimmed>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
  </PropertyGroup>

  <!-- Release packaging only: pass -p:SpaceOpsRelease=true (see .github/workflows/release.yml, docs/releasing.md).
       Bundles the .NET runtime and the Windows App SDK runtime so the zip runs on a clean machine.
       Regular `dotnet build` / CI / integration tests are unaffected. -->
  <PropertyGroup Condition="'$(SpaceOpsRelease)' == 'true'">
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <!-- Unpackaged `dotnet publish` omits the compiled XAML (*.xbf), the app's resource index (*.pri) and Assets\,
       which makes the app crash in Microsoft.UI.Xaml.dll at startup. Copy them from the build output. -->
  <Target Name="IncludeXamlOutputsInPublish" AfterTargets="Publish" Condition="'$(SpaceOpsRelease)' == 'true'">
    <ItemGroup>
      <_XamlOut Include="$(OutDir)**\*.xbf" />
      <_XamlOut Include="$(OutDir)$(TargetName).pri" />
      <_AssetsOut Include="$(OutDir)Assets\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_XamlOut)" DestinationFiles="@(_XamlOut->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_AssetsOut)" DestinationFiles="@(_AssetsOut->'$(PublishDir)Assets\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- Copies the Rust core's cdylib next to the app (ADR-001/002: unpackaged, in-process DLL). -->
  <Target Name="CopyNativeFfiDll" AfterTargets="Build">
    <PropertyGroup>
      <_CargoProfileDir Condition="'$(Configuration)' == 'Debug'">debug</_CargoProfileDir>
      <_CargoProfileDir Condition="'$(Configuration)' != 'Debug'">release</_CargoProfileDir>
    </PropertyGroup>
    <ItemGroup>
      <_NativeFfiDll Include="$(MSBuildProjectDirectory)\..\..\core\target\$(_CargoProfileDir)\ffi.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_NativeFfiDll)" DestinationFolder="$(OutDir)" Condition="Exists('%(_NativeFfiDll.Identity)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
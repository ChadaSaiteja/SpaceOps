<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StorageIntelligence.Pages.CleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:StorageIntelligence.Services"
    Background="Transparent">

    <Grid Padding="22,18" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE74D;" FontSize="20" Foreground="{StaticResource SpaceOrangeBrush}" />
            <TextBlock Text="Smart Storage Cleanup" Style="{StaticResource SpacePageTitleStyle}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 2. One reclaimable total across system junk, dev artifacts and app leftovers -->
        <Border Grid.Row="1" Style="{StaticResource SpaceCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock x:Name="CleanupTotalText" Text="Calculating reclaimable storage..." FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource SpaceAccentBrush}" />
                    <TextBlock x:Name="CleanupBreakdownText" Text="" FontSize="12" Foreground="{StaticResource SpaceSubBrush}" />
                    <TextBlock Text="Zero-Accident Safety: Protected system roots excluded. All deletions default to Recycle Bin." FontSize="11" Foreground="{StaticResource SpaceMutedBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ProgressRing x:Name="AnalyzeRing" Width="20" Height="20" IsActive="False" />
                    <Button x:Name="AnalyzeButton" Click="AnalyzeCleanup_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            <TextBlock Text="Re-Analyze" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Source filter and bulk selection -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="SourceFilterCombo" Width="190" SelectedIndex="0" SelectionChanged="SourceFilterCombo_SelectionChanged">
                <ComboBoxItem Content="All sources" />
                <ComboBoxItem Content="System junk" />
                <ComboBoxItem Content="Developer artifacts" />
                <ComboBoxItem Content="App leftovers" />
            </ComboBox>
            <TextBlock x:Name="SelectedTotalText" Grid.Column="1" Text="" FontSize="12" Foreground="{StaticResource SpaceSubBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Select safe" Click="SelectSafe_Click" ToolTipService.ToolTip="Select every low-risk, unprotected item" />
                <Button Content="Clear" Click="ClearSelection_Click" />
            </StackPanel>
        </Grid>

        <!-- 4. Unified candidate list -->
        <ListView Grid.Row="3" x:Name="CleanupCandidatesList" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="svc:UnifiedCandidate">
                    <Border Style="{StaticResource SpaceRowStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox
                                Grid.Column="0"
                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                IsEnabled="{x:Bind CanSelect}"
                                Checked="Candidate_SelectionChanged"
                                Unchecked="Candidate_SelectionChanged"
                                VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock HorizontalAlignment="Left" Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                    <Border Background="{x:Bind SourceBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind SourceText}" FontSize="10" Foreground="{StaticResource SpaceOnAccentBrush}" FontWeight="SemiBold" />
                                    </Border>
                                    <Border Background="{x:Bind RiskBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind RiskText}" FontSize="10" Foreground="{StaticResource SpaceOnAccentBrush}" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{StaticResource SpaceSubBrush}" TextWrapping="Wrap" />
                                <TextBlock HorizontalAlignment="Left" Text="{x:Bind PathDisplay}" FontSize="10" Foreground="{StaticResource SpaceMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="560" ToolTipService.ToolTip="{x:Bind PathDisplay}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{x:Bind FormattedSize}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right" Foreground="{StaticResource SpaceAccentBrush}" />
                                <TextBlock Text="{x:Bind FileCountText}" FontSize="11" Foreground="{StaticResource SpaceMutedBrush}" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 5. Safety options -->
        <StackPanel Grid.Row="4" Spacing="6">
            <CheckBox x:Name="RecycleBinCheckBox" IsChecked="True" Content="Send to Windows Recycle Bin (Recoverable, Recommended)" />
            <CheckBox x:Name="DryRunCheckBox" IsChecked="False" Content="Dry-Run Simulation Only (Audit space without removing files)" />
        </StackPanel>

        <!-- 6. Action bar and status -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CleanupStatusText" Text="Ready" FontSize="12" Foreground="{StaticResource SpaceSubBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button x:Name="ExecuteCleanupButton" Grid.Column="1" Style="{ThemeResource AccentButtonStyle}" Click="ExecuteCleanup_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                    <TextBlock Text="Clean Selected Items" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>

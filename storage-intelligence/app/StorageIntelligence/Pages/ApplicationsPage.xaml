<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StorageIntelligence.Pages.ApplicationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StorageIntelligence"
    Background="Transparent">

    <Grid Padding="22,18" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE71D;" FontSize="20" Foreground="{StaticResource SpaceAccentBrush}" />
            <TextBlock Text="Installed Applications &amp; Storage Attribution" Style="{StaticResource SpacePageTitleStyle}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 2. Search, filter and toolbar -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="AppFilterTextBox"
                Grid.Column="0"
                PlaceholderText="Filter apps by name or publisher..."
                TextChanged="AppFilterTextBox_TextChanged"
                VerticalAlignment="Center" />

            <ComboBox
                x:Name="AppTypeFilterCombo"
                Grid.Column="1"
                SelectedIndex="0"
                SelectionChanged="AppTypeFilterCombo_SelectionChanged"
                VerticalAlignment="Center"
                Width="140">
                <ComboBoxItem Content="All Types" />
                <ComboBoxItem Content="Desktop (Win32)" />
                <ComboBoxItem Content="Store (MSIX)" />
            </ComboBox>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button x:Name="RefreshAppsButton" Click="RefreshApps_Click" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
                <Button x:Name="ToggleLeftoversButton" Click="ToggleLeftovers_Click" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{StaticResource SpaceOrangeBrush}" />
                        <TextBlock x:Name="ToggleLeftoversText" Text="View Leftovers" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 3. Applications / leftovers lists -->
        <Grid Grid.Row="2">
            <!-- Apps panel -->
            <ListView x:Name="InstalledAppsListView" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:InstalledAppViewModel">
                        <Border Style="{StaticResource SpaceRowStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{x:Bind KindBrush}" VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="18" Foreground="{StaticResource SpaceOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock HorizontalAlignment="Left" Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                        <Border Background="{StaticResource SpaceNavOnBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Version}" FontSize="10" Foreground="{StaticResource SpaceSubBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Left" Text="{x:Bind Publisher}" FontSize="11" Foreground="{StaticResource SpaceSubBrush}" TextTrimming="CharacterEllipsis" MaxWidth="350" />
                                    <TextBlock HorizontalAlignment="Left" Text="{x:Bind InstallLocation}" FontSize="10" Foreground="{StaticResource SpaceMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="450" ToolTipService.ToolTip="{x:Bind InstallLocation}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0">
                                    <TextBlock Text="{x:Bind FormattedSize}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" Foreground="{StaticResource SpaceAccentBrush}" />
                                    <TextBlock Text="{x:Bind FileCountText}" FontSize="11" Foreground="{StaticResource SpaceSubBrush}" HorizontalAlignment="Right" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button ToolTipService.ToolTip="Show in File Explorer" Click="AppOpenLocation_Click" Tag="{x:Bind}" IsEnabled="{x:Bind HasInstallLocation}">
                                        <FontIcon Glyph="&#xED25;" FontSize="12" />
                                    </Button>
                                    <Button Content="Uninstall" Click="AppUninstall_Click" Tag="{x:Bind}" IsEnabled="{x:Bind CanUninstall}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Leftovers panel (initially collapsed) -->
            <ListView x:Name="LeftoversListView" SelectionMode="None" Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:AppLeftoverViewModel">
                        <Border Style="{StaticResource SpaceRowStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{StaticResource SpaceOrangeBrush}" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="{StaticResource SpaceOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind AppName}" FontWeight="SemiBold" FontSize="13" />
                                        <Border Background="{x:Bind RiskBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind LocationTypeText}" FontSize="10" Foreground="{StaticResource SpaceOnAccentBrush}" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Left" Text="{x:Bind Path}" FontSize="10" Foreground="{StaticResource SpaceMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="480" ToolTipService.ToolTip="{x:Bind Path}" />
                                    <TextBlock Text="{x:Bind StatusText}" FontSize="11" Foreground="{StaticResource SpaceSubBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0">
                                    <TextBlock Text="{x:Bind FormattedSize}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right" Foreground="{StaticResource SpaceOrangeBrush}" />
                                    <TextBlock Text="{x:Bind FileCountText}" FontSize="11" Foreground="{StaticResource SpaceSubBrush}" HorizontalAlignment="Right" />
                                </StackPanel>

                                <Button Grid.Column="3" Content="Clean" Click="CleanLeftover_Click" Tag="{x:Bind}" IsEnabled="{x:Bind CanClean}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- 4. Footer summary -->
        <TextBlock x:Name="AppsSummaryText" Grid.Row="3" Text="Loading installed applications..." FontSize="12" Foreground="{StaticResource SpaceSubBrush}" VerticalAlignment="Center" />
    </Grid>
</Page>

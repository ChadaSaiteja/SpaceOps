<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StorageIntelligence.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StorageIntelligence.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:StorageIntelligence"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <!-- Top Command & Scan Bar -->
            <RowDefinition Height="Auto" />
            <!-- Navigation / Breadcrumb Bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Treemap & Sidebar Content Area -->
            <RowDefinition Height="*" />
            <!-- Bottom Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Top Header & Scan Controls -->
        <Border
            Grid.Row="0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xEDA2;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Target Path:" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <TextBox
                    x:Name="PathTextBox"
                    Grid.Column="1"
                    PlaceholderText="Enter drive or folder path (e.g. C:\ or D:\projects)"
                    Text="C:\"
                    VerticalAlignment="Center" />

                <Button
                    x:Name="ScanButton"
                    Grid.Column="2"
                    Style="{ThemeResource AccentButtonStyle}"
                    Click="ScanButton_Click"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                        <TextBlock Text="Scan &amp; Visualize" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="CancelButton"
                    Grid.Column="3"
                    Click="CancelButton_Click"
                    IsEnabled="False"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                        <TextBlock Text="Cancel" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="CleanupButton"
                    Grid.Column="4"
                    Click="CleanupButton_Click"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#FF9800" />
                        <TextBlock Text="Smart Cleanup" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="AppsButton"
                    Grid.Column="5"
                    Click="AppsButton_Click"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE71D;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Applications" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="DevStorageButton"
                    Grid.Column="6"
                    Click="DevStorageButton_Click"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE790;" FontSize="14" Foreground="#10B981" />
                        <TextBlock Text="Dev Storage" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="SyncButton"
                    Grid.Column="7"
                    Click="SyncButton_Click"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Fast incremental sync / load from local SQLite index (ADR-016)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE895;" FontSize="14" Foreground="#3B82F6" />
                        <TextBlock x:Name="SyncButtonText" Text="Sync Index" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 2. Breadcrumb & Navigation Bar with Real-time Search -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,6">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="UpButton"
                    Grid.Column="0"
                    Style="{ThemeResource SubtleButtonStyle}"
                    Click="UpButton_Click"
                    ToolTipService.ToolTip="Navigate to parent folder"
                    Margin="0,0,4,0">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>

                <BreadcrumbBar
                    x:Name="Breadcrumbs"
                    Grid.Column="1"
                    ItemClicked="Breadcrumbs_ItemClicked"
                    VerticalAlignment="Center" />

                <!-- Real-time Search & Filter Engine (Phase 5, ADR-012) -->
                <AutoSuggestBox
                    x:Name="SearchBox"
                    Grid.Column="2"
                    PlaceholderText="Search files, ext:vhdx, size:>1GB..."
                    QueryIcon="Find"
                    TextChanged="SearchBox_TextChanged"
                    SuggestionChosen="SearchBox_SuggestionChosen"
                    QuerySubmitted="SearchBox_QuerySubmitted"
                    VerticalAlignment="Center">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="local:SearchResultViewModel">
                            <Grid ColumnSpacing="10" Margin="0,4" MinWidth="300">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="4" Background="{x:Bind CategoryBrush}" VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                    <TextBlock Text="{x:Bind FullPath}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind FormattedSize}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" />
                                    <TextBlock Text="{x:Bind CategoryText}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>

                <!-- Quick Depth Selector -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Depth:" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="DepthComboBox" SelectionChanged="DepthComboBox_SelectionChanged" SelectedIndex="1" Width="76">
                        <ComboBoxItem Content="1" Tag="1" />
                        <ComboBoxItem Content="2" Tag="2" />
                        <ComboBoxItem Content="3" Tag="3" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Main Split View: Treemap (Left) + Details & Legend (Right) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="340" MinWidth="260" MaxWidth="500" />
            </Grid.ColumnDefinitions>

            <!-- Treemap Viewport -->
            <controls:TreemapControl
                x:Name="Treemap"
                Grid.Column="0"
                NodeSelected="Treemap_NodeSelected"
                DrillDownChanged="Treemap_DrillDownChanged" />

            <!-- Sidebar Details & Category Legend -->
            <Border
                Grid.Column="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel Spacing="20">
                        <!-- Selection Details Card -->
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon x:Name="DetailIcon" Glyph="&#xE8B7;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="DetailTitle" Text="No Selection" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Path:" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock x:Name="DetailPath" Text="—" FontSize="12" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="Allocated Size" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock x:Name="DetailSize" Text="—" FontSize="14" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Category" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock x:Name="DetailCategory" Text="—" FontSize="13" />
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="DirStatsGrid" ColumnSpacing="8" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="Files" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock x:Name="DetailFileCount" Text="0" FontSize="13" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Subdirectories" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock x:Name="DetailDirCount" Text="0" FontSize="13" />
                                    </StackPanel>
                                </Grid>

                                <!-- Action Buttons -->
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <Button x:Name="DrillDownButton" Style="{ThemeResource AccentButtonStyle}" Click="DrillDownButton_Click" IsEnabled="False" Content="Drill Down" />
                                    <Button x:Name="OpenExplorerButton" Click="OpenExplorerButton_Click" IsEnabled="False" Content="Show in Explorer" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Category Color Legend -->
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="File Types &amp; Categories" FontWeight="SemiBold" FontSize="14" />
                                
                                <Grid RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Video -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="#8A2BE2" />
                                        <TextBlock Text="Video" FontSize="12" />
                                    </StackPanel>
                                    <!-- Audio -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="#FF1493" />
                                        <TextBlock Text="Audio" FontSize="12" />
                                    </StackPanel>

                                    <!-- Images -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="#FF8C00" />
                                        <TextBlock Text="Images" FontSize="12" />
                                    </StackPanel>
                                    <!-- Documents -->
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="#1E90FF" />
                                        <TextBlock Text="Documents" FontSize="12" />
                                    </StackPanel>

                                    <!-- Archives -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="#32CD32" />
                                        <TextBlock Text="Archives" FontSize="12" />
                                    </StackPanel>
                                    <!-- Executables -->
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="#DC143C" />
                                        <TextBlock Text="Programs" FontSize="12" />
                                    </StackPanel>

                                    <!-- Code -->
                                    <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="#00CED1" />
                                        <TextBlock Text="Code &amp; Data" FontSize="12" />
                                    </StackPanel>
                                    <!-- System -->
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="#708090" />
                                        <TextBlock Text="System" FontSize="12" />
                                    </StackPanel>

                                    <!-- Other -->
                                    <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="#696969" />
                                        <TextBlock Text="Other" FontSize="12" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 4. Bottom Progress & Status Bar -->
        <Border
            Grid.Row="3"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <ProgressBar x:Name="ScanProgressBar" Width="180" IsIndeterminate="True" Visibility="Collapsed" />
                    <TextBlock x:Name="StatusTextBlock" Text="Ready" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="MetricsTextBlock" Grid.Column="1" Text="" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 5. Smart Cleanup Modal Overlay (Phase 6, ADR-013) -->
        <Grid
            x:Name="CleanupOverlay"
            Grid.Row="0"
            Grid.RowSpan="4"
            Background="#99000000"
            Visibility="Collapsed">

            <Border
                Width="700"
                MaxHeight="620"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24">

                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 1. Header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE74D;" FontSize="20" Foreground="#FF9800" />
                            <TextBlock Text="Smart Storage Cleanup" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{ThemeResource SubtleButtonStyle}" Click="CloseCleanup_Click" ToolTipService.ToolTip="Close">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>

                    <!-- 2. Reclaimable Summary Banner -->
                    <Border
                        Grid.Row="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock x:Name="CleanupTotalText" Text="Calculating reclaimable storage..." FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Zero-Accident Safety: Protected system roots excluded. All deletions default to Recycle Bin." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="AnalyzeCleanup_Click" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                    <TextBlock Text="Re-Analyze" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 3. Candidate Categories List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="300">
                        <ListView x:Name="CleanupCandidatesList" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:CleanupCandidateViewModel">
                                    <Border
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,4">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox
                                                Grid.Column="0"
                                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" />
                                                    <Border Background="{x:Bind RiskBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind RiskText}" FontSize="10" Foreground="White" FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind PathDisplay}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{x:Bind FormattedSize}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind FileCountText}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>

                    <!-- 4. Safety Options -->
                    <StackPanel Grid.Row="3" Spacing="6">
                        <CheckBox x:Name="RecycleBinCheckBox" IsChecked="True" Content="Send to Windows Recycle Bin (Recoverable, Recommended)" />
                        <CheckBox x:Name="DryRunCheckBox" IsChecked="False" Content="Dry-Run Simulation Only (Audit space without removing files)" />
                    </StackPanel>

                    <!-- 5. Action Bar & Status -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CleanupStatusText" Text="Ready" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="Close" Click="CloseCleanup_Click" />
                            <Button x:Name="ExecuteCleanupButton" Style="{ThemeResource AccentButtonStyle}" Click="ExecuteCleanup_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                    <TextBlock Text="Clean Selected Items" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 6. Applications & Leftovers Modal Overlay (Phase 7, ADR-014) -->
        <Grid
            x:Name="AppsOverlay"
            Grid.Row="0"
            Grid.RowSpan="4"
            Background="#99000000"
            Visibility="Collapsed">

            <Border
                Width="850"
                MaxHeight="700"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24">

                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 1. Header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE71D;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Installed Applications &amp; Storage Attribution" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{ThemeResource SubtleButtonStyle}" Click="CloseApps_Click" ToolTipService.ToolTip="Close">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>

                    <!-- 2. Search, Filter & Toolbar -->
                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            x:Name="AppFilterTextBox"
                            Grid.Column="0"
                            PlaceholderText="Filter apps by name or publisher..."
                            TextChanged="AppFilterTextBox_TextChanged"
                            VerticalAlignment="Center" />

                        <ComboBox
                            x:Name="AppTypeFilterCombo"
                            Grid.Column="1"
                            SelectedIndex="0"
                            SelectionChanged="AppTypeFilterCombo_SelectionChanged"
                            VerticalAlignment="Center"
                            Width="140">
                            <ComboBoxItem Content="All Types" />
                            <ComboBoxItem Content="Desktop (Win32)" />
                            <ComboBoxItem Content="Store (MSIX)" />
                        </ComboBox>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button x:Name="RefreshAppsButton" Click="RefreshApps_Click" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                    <TextBlock Text="Refresh" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ToggleLeftoversButton" Click="ToggleLeftovers_Click" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="#FF9800" />
                                    <TextBlock x:Name="ToggleLeftoversText" Text="View Leftovers" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 3. Applications List View -->
                    <Grid Grid.Row="2">
                        <!-- Apps Panel -->
                        <ScrollViewer x:Name="AppsScrollViewer" VerticalScrollBarVisibility="Auto" MaxHeight="450">
                            <ListView x:Name="InstalledAppsListView" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:InstalledAppViewModel">
                                        <Border
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12"
                                            Margin="0,4">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="{x:Bind KindBrush}" VerticalAlignment="Center">
                                                    <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                                        <Border Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Version}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Publisher}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="350" />
                                                    <TextBlock Text="{x:Bind InstallLocation}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="350" ToolTipService.ToolTip="{x:Bind InstallLocation}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0">
                                                    <TextBlock Text="{x:Bind FormattedSize}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind FileCountText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Button ToolTipService.ToolTip="Show in File Explorer" Click="AppOpenLocation_Click" Tag="{x:Bind}" IsEnabled="{x:Bind HasInstallLocation}">
                                                        <FontIcon Glyph="&#xED25;" FontSize="12" />
                                                    </Button>
                                                    <Button Content="Uninstall" Click="AppUninstall_Click" Tag="{x:Bind}" IsEnabled="{x:Bind CanUninstall}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ScrollViewer>

                        <!-- Leftovers Panel (Initially Collapsed) -->
                        <ScrollViewer x:Name="LeftoversScrollViewer" VerticalScrollBarVisibility="Auto" MaxHeight="450" Visibility="Collapsed">
                            <ListView x:Name="LeftoversListView" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:AppLeftoverViewModel">
                                        <Border
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12"
                                            Margin="0,4">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="#FF9800" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind AppName}" FontWeight="SemiBold" FontSize="13" />
                                                        <Border Background="{x:Bind RiskBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind LocationTypeText}" FontSize="10" Foreground="White" FontWeight="SemiBold" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Path}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="400" ToolTipService.ToolTip="{x:Bind Path}" />
                                                    <TextBlock Text="{x:Bind StatusText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0">
                                                    <TextBlock Text="{x:Bind FormattedSize}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right" Foreground="#FF9800" />
                                                    <TextBlock Text="{x:Bind FileCountText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                                                </StackPanel>

                                                <Button Grid.Column="3" Content="Clean" Click="CleanLeftover_Click" Tag="{x:Bind}" IsEnabled="{x:Bind CanClean}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ScrollViewer>
                    </Grid>

                    <!-- 4. Footer Summary Bar -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AppsSummaryText" Text="Loading installed applications..." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Close" Click="CloseApps_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 7. Developer Storage Intelligence Modal Overlay (Phase 8, ADR-015) -->
        <Grid
            x:Name="DevStorageOverlay"
            Grid.Row="0"
            Grid.RowSpan="4"
            Background="#99000000"
            Visibility="Collapsed">

            <Border
                Width="900"
                MaxHeight="700"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24">

                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 1. Header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE790;" FontSize="20" Foreground="#10B981" />
                            <TextBlock Text="Developer Storage Intelligence" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{ThemeResource SubtleButtonStyle}" Click="CloseDevStorage_Click" ToolTipService.ToolTip="Close">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>

                    <!-- 2. Search, Filter & Actions Toolbar -->
                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            x:Name="DevFilterTextBox"
                            Grid.Column="0"
                            PlaceholderText="Filter by project or path..."
                            TextChanged="DevFilterTextBox_TextChanged"
                            VerticalAlignment="Center" />

                        <ComboBox
                            x:Name="DevEcosystemFilterCombo"
                            Grid.Column="1"
                            SelectedIndex="0"
                            SelectionChanged="DevEcosystemFilterCombo_SelectionChanged"
                            VerticalAlignment="Center"
                            Width="160">
                            <ComboBoxItem Content="All Ecosystems" />
                            <ComboBoxItem Content="Node.js / JS" />
                            <ComboBoxItem Content="Rust / Cargo" />
                            <ComboBoxItem Content=".NET / C#" />
                            <ComboBoxItem Content="Python / pip" />
                            <ComboBoxItem Content="Java / Gradle" />
                            <ComboBoxItem Content="Docker &amp; WSL" />
                            <ComboBoxItem Content="Git Repos" />
                        </ComboBox>

                        <CheckBox
                            x:Name="DevDormantOnlyCheck"
                            Grid.Column="2"
                            Content="Dormant Only (&gt;30d)"
                            Checked="DevDormantOnlyCheck_Changed"
                            Unchecked="DevDormantOnlyCheck_Changed"
                            VerticalAlignment="Center" />

                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button x:Name="RefreshDevStorageButton" Click="RefreshDevStorage_Click" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                    <TextBlock Text="Scan Dev Storage" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 3. Discovered Developer Artifacts List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="450">
                        <ListView x:Name="DevArtifactsListView" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:DevArtifactViewModel">
                                    <Border
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,4">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Ecosystem Icon -->
                                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="6" Background="{x:Bind EcosystemBrush}" VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Details -->
                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind ProjectName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                                                    <Border Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Name}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                    <Border Background="{x:Bind DormancyBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind DormancyText}" FontSize="10" Foreground="White" FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Path}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="400" ToolTipService.ToolTip="{x:Bind Path}" />
                                                <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="400" />
                                            </StackPanel>

                                            <!-- Size & File Count -->
                                            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0">
                                                <TextBlock Text="{x:Bind FormattedSize}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" Foreground="#10B981" />
                                                <TextBlock Text="{x:Bind FileCountText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                                            </StackPanel>

                                            <!-- Actions: 1-click clean or CLI command guidance -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button ToolTipService.ToolTip="Show in File Explorer" Click="DevOpenLocation_Click" Tag="{x:Bind}">
                                                    <FontIcon Glyph="&#xED25;" FontSize="12" />
                                                </Button>
                                                <Button Content="Clean (Recycle Bin)" Click="DevCleanArtifact_Click" Tag="{x:Bind}" IsEnabled="{x:Bind CanDirectClean}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>

                    <!-- 4. Footer Summary Bar -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DevStorageSummaryText" Text="Click 'Scan Dev Storage' to analyze developer artifacts." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Close" Click="CloseDevStorage_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StorageIntelligence.Pages.DeveloperPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StorageIntelligence"
    Background="Transparent">

    <Grid Padding="22,18" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE943;" FontSize="20" Foreground="{StaticResource SpaceGreenBrush}" />
            <TextBlock Text="Developer Storage Intelligence" Style="{StaticResource SpacePageTitleStyle}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 2. Search, filter and actions toolbar -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="DevFilterTextBox"
                Grid.Column="0"
                PlaceholderText="Filter by project or path..."
                TextChanged="DevFilterTextBox_TextChanged"
                VerticalAlignment="Center" />

            <ComboBox
                x:Name="DevEcosystemFilterCombo"
                Grid.Column="1"
                SelectedIndex="0"
                SelectionChanged="DevEcosystemFilterCombo_SelectionChanged"
                VerticalAlignment="Center"
                Width="160">
                <ComboBoxItem Content="All Ecosystems" />
                <ComboBoxItem Content="Node.js / JS" />
                <ComboBoxItem Content="Rust / Cargo" />
                <ComboBoxItem Content=".NET / C#" />
                <ComboBoxItem Content="Python / pip" />
                <ComboBoxItem Content="Java / Gradle" />
                <ComboBoxItem Content="Docker &amp; WSL" />
                <ComboBoxItem Content="Git Repos" />
            </ComboBox>

            <CheckBox
                x:Name="DevDormantOnlyCheck"
                Grid.Column="2"
                Content="Dormant Only (&gt;30d)"
                Checked="DevDormantOnlyCheck_Changed"
                Unchecked="DevDormantOnlyCheck_Changed"
                VerticalAlignment="Center" />

            <Button x:Name="RefreshDevStorageButton" Grid.Column="4" Click="RefreshDevStorage_Click" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    <TextBlock Text="Scan Dev Storage" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 3. Discovered developer artifacts -->
        <ListView Grid.Row="2" x:Name="DevArtifactsListView" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:DevArtifactViewModel">
                    <Border Style="{StaticResource SpaceRowStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Ecosystem icon -->
                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8" Background="{x:Bind EcosystemBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="18" Foreground="{StaticResource SpaceOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Details -->
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock HorizontalAlignment="Left" Text="{x:Bind ProjectName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                                    <Border Background="{StaticResource SpaceNavOnBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SpaceSubBrush}" />
                                    </Border>
                                    <Border Background="{x:Bind DormancyBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind DormancyText}" FontSize="10" Foreground="{StaticResource SpaceOnAccentBrush}" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock HorizontalAlignment="Left" Text="{x:Bind Path}" FontSize="10" Foreground="{StaticResource SpaceMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="480" ToolTipService.ToolTip="{x:Bind Path}" />
                                <TextBlock HorizontalAlignment="Left" Text="{x:Bind Description}" FontSize="11" Foreground="{StaticResource SpaceSubBrush}" TextTrimming="CharacterEllipsis" MaxWidth="480" />
                            </StackPanel>

                            <!-- Size and file count -->
                            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0">
                                <TextBlock Text="{x:Bind FormattedSize}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" Foreground="{StaticResource SpaceGreenBrush}" />
                                <TextBlock Text="{x:Bind FileCountText}" FontSize="11" Foreground="{StaticResource SpaceSubBrush}" HorizontalAlignment="Right" />
                            </StackPanel>

                            <!-- Actions: 1-click clean or CLI command guidance -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button ToolTipService.ToolTip="Show in File Explorer" Click="DevOpenLocation_Click" Tag="{x:Bind}">
                                    <FontIcon Glyph="&#xED25;" FontSize="12" />
                                </Button>
                                <Button Content="Clean (Recycle Bin)" Click="DevCleanArtifact_Click" Tag="{x:Bind}" IsEnabled="{x:Bind CanDirectClean}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 4. Footer summary -->
        <TextBlock x:Name="DevStorageSummaryText" Grid.Row="3" Text="Click 'Scan Dev Storage' to analyze developer artifacts." FontSize="12" Foreground="{StaticResource SpaceSubBrush}" VerticalAlignment="Center" />
    </Grid>
</Page>

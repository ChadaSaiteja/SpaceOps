<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StorageIntelligence.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:StorageIntelligence"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource SpaceBgBrush}">

    <!-- Fluent Sidebar shell: left NavigationView, slim header (target path / Scan / Sync index), status bar. -->
    <NavigationView
        x:Name="Nav"
        PaneDisplayMode="Left"
        IsPaneOpen="True"
        OpenPaneLength="224"
        IsPaneToggleButtonVisible="False"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        IsTitleBarAutoPaddingEnabled="False"
        SelectionChanged="Nav_SelectionChanged"
        Loaded="Nav_Loaded">

        <NavigationView.PaneHeader>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,12,0,8">
                <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource SpaceAccentGradientBrush}">
                    <FontIcon Glyph="&#xEDA2;" FontSize="15" Foreground="{StaticResource SpaceOnAccentBrush}" />
                </Border>
                <TextBlock Text="SpaceOps" FontSize="16" FontWeight="ExtraBold" Foreground="{StaticResource SpaceTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </NavigationView.PaneHeader>

        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="NavOverview" Content="Overview" Tag="overview">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE80F;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="NavTreemap" Content="Treemap" Tag="treemap">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xF0E2;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="NavCleanup" Content="Cleanup" Tag="cleanup">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="NavDeveloper" Content="Developer" Tag="developer">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE943;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="NavApplications" Content="Applications" Tag="applications">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE71D;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <!-- Drive usage card pinned to the bottom of the sidebar -->
        <NavigationView.PaneFooter>
            <Border Style="{StaticResource SpaceCardStyle}" Margin="10,8,10,12" Padding="12" CornerRadius="10">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEDA2;" FontSize="14" Foreground="{StaticResource SpaceAccentBrush}" />
                        <TextBlock x:Name="DriveNameText" Text="Drive" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SpaceTextBrush}" />
                    </StackPanel>
                    <ProgressBar x:Name="DriveUsageBar" Minimum="0" Maximum="100" Value="0" Height="6" CornerRadius="3" />
                    <TextBlock x:Name="DriveUsageText" Text="—" FontSize="11" Foreground="{StaticResource SpaceSubBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </NavigationView.PaneFooter>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Slim header -->
                <RowDefinition Height="Auto" />
                <!-- Page content -->
                <RowDefinition Height="*" />
                <!-- Bottom status bar -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="{StaticResource SpaceSurfaceBrush}"
                BorderBrush="{StaticResource SpaceBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" ColumnSpacing="8"
                          Background="{StaticResource SpaceFieldBrush}"
                          BorderBrush="{StaticResource SpaceBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="8"
                          Padding="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{StaticResource SpaceAccentBrush}" VerticalAlignment="Center" />
                        <TextBox
                            x:Name="PathTextBox"
                            Grid.Column="1"
                            BorderThickness="0"
                            Background="Transparent"
                            PlaceholderText="Enter drive or folder path (e.g. C:\ or D:\projects)"
                            TextChanged="PathTextBox_TextChanged"
                            LostFocus="PathTextBox_LostFocus"
                            VerticalAlignment="Center" />
                    </Grid>

                    <Button
                        x:Name="ScanButton"
                        Grid.Column="1"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="ScanButton_Click"
                        VerticalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock Text="Scan" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="CancelButton"
                        Grid.Column="2"
                        Click="CancelButton_Click"
                        IsEnabled="False"
                        VerticalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                            <TextBlock Text="Cancel" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="SyncButton"
                        Grid.Column="3"
                        Click="SyncButton_Click"
                        VerticalAlignment="Stretch"
                        ToolTipService.ToolTip="Fast incremental sync / load from local SQLite index (ADR-016)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE895;" FontSize="14" Foreground="{StaticResource SpaceAccent2Brush}" />
                            <TextBlock Text="Sync index" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Frame x:Name="ContentFrame" Grid.Row="1" CacheSize="10" />

            <Border
                Grid.Row="2"
                Background="{StaticResource SpaceSurfaceBrush}"
                BorderBrush="{StaticResource SpaceBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <ProgressBar x:Name="ScanProgressBar" Width="160" IsIndeterminate="True" Visibility="Collapsed" />
                        <TextBlock x:Name="StatusTextBlock" Text="Ready" FontSize="12" Foreground="{StaticResource SpaceSubBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="MetricsTextBlock" Grid.Column="1" Text="" FontSize="12" Foreground="{StaticResource SpaceMutedBrush}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </NavigationView>
</Page>

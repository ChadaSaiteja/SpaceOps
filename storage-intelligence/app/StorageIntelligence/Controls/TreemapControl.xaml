<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="StorageIntelligence.Controls.TreemapControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:StorageIntelligence.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <!-- Direct2D Hardware-Accelerated Canvas -->
        <canvas:CanvasControl
            x:Name="Canvas"
            CreateResources="Canvas_CreateResources"
            Draw="Canvas_Draw"
            PointerMoved="Canvas_PointerMoved"
            PointerExited="Canvas_PointerExited"
            PointerPressed="Canvas_PointerPressed"
            DoubleTapped="Canvas_DoubleTapped"
            SizeChanged="Canvas_SizeChanged" />

        <!-- Floating Tooltip for Hovered Node -->
        <Popup x:Name="HoverPopup" IsHitTestVisible="False">
            <Border
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,6">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="TooltipTitle" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock x:Name="TooltipSize" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="TooltipPath" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" MaxWidth="400" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- Empty / Placeholder State -->
        <StackPanel
            x:Name="EmptyStatePanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="Visible">
            <FontIcon Glyph="&#xE8B9;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock
                Text="Select a drive or directory to scan and view the treemap"
                FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
